<footer>
  <div>
    <h6>{{ site.title }}</h6>
    <p>{{ site.description }}</p>
  </div>
  <div>
    <h6>Legal</h6>
      <ul>
        <li><a href="{{ '/privacy/' | url }}">Privacy Policy</a></li>
        <li><a href="{{ '/cookies/' | url }}">Cookie Policy</a></li>
        <li><a href="{{ '/terms/' | url }}">Terms and conditions</a></li>
      </ul>
  </div>

  <hr />

  <div class="copyright">
    <p>
      &copy; {{ site.copyright.year }} {{ site.siteName }} - {{ site.copyright.text }}
    </p>
  </div>
</footer>